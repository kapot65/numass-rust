{
    "lsp": {
        "rust-analyzer": {
            "initialization_options": {
                "check": {
                    "command": "clippy",
                    "workspace": true
                },
                "diagnostics": {
                    "styleLints": {
                        "enable": true
                    }
                }
            }
        },
        "yaml-language-server": {
            "settings": {
                "yaml": {
                    "customTags": ["!Trapezoid mapping", "!FirstPeak mapping"]
                }
            }
        }
    }
}
